@startuml HireMe_Architecture
!theme plain
skinparam backgroundColor #1a1a2e
skinparam defaultFontColor #e0e0e0
skinparam defaultFontName "JetBrains Mono"
skinparam ArrowColor #7c3aed
skinparam BorderColor #4a4a6a

skinparam package {
  BackgroundColor #16213e
  BorderColor #7c3aed
  FontColor #c4b5fd
}

skinparam component {
  BackgroundColor #0f3460
  BorderColor #7c3aed
  FontColor #e0e0e0
}

skinparam database {
  BackgroundColor #0d1b2a
  BorderColor #10b981
  FontColor #6ee7b7
}

skinparam actor {
  BackgroundColor #1e1e3a
  BorderColor #7c3aed
  FontColor #c4b5fd
}

skinparam note {
  BackgroundColor #1a1040
  BorderColor #6d28d9
  FontColor #d8b4fe
}

title HireMe — System Architecture v2.0

' ── Actors ─────────────────────────────────────────────────────
actor "User\n(Candidate/Admin)" as USER #8b5cf6

' ── Frontend ─────────────────────────────────────────────────────
package "Next.js Frontend (Port 3000)" as FE {
  component "dashboard/page.tsx\n[Curated Feed & Filters]" as DASH
  component "admin/page.tsx\n[Crawler Telemetry & Control]" as ADMINUI
  component "history/page.tsx\n[Application Tracker]" as HISTUI
  component "profile/page.tsx\n[Profile & Resume Upload]" as PROFUI
  component "lib/api.ts\n[REST Client]" as APICLIENT
  component "lib/matchScore.ts\n[Client-side Scoring]" as SCORE
  component "context/PreferencesContext\n[localStorage & Sync]" as CTX
  component "components/dashboard/\nJobCard · FilterSidebar\nJobDetailsSheet · AppliedConfirmModal" as UICOMP
}

' ── Backend ─────────────────────────────────────────────────────
package "FastAPI Backend (Port 8000)" as BE {
  component "main.py\n[REST Endpoints & Routing]" as MAIN
  component "worker.py\nperiodic_worker()\nscrape_all_sites()" as WORKER
  component "filters.py\nsearch_jobs_from_db()\nCursor & Offset Paging" as FILTERS
  component "resume_analyzer.py\nPyPDF + Skill Extractor" as RESUME
  component "cache.py\n[In-Memory TTL Cache]" as CACHE
  database "SQLite Database (WAL Mode)\njobs · user_profiles\njob_applications · dead_reports" as SQLITEDB
}

' ── Scraper Layer ─────────────────────────────────────────────────
package "Scraper Registry (backend/scrapers/)" as SCRAPERS {
  component "BaseScraper ABC\n+ SearchFilters" as BASE
  component "AmazonJobsScraper\ncurl_cffi chrome120" as AMAZON
  component "GoogleCareersScraper\ncurl_cffi chrome120" as GOOGLE
  component "MicrosoftCareersScraper\ncurl_cffi chrome120" as MSFT
  component "MetaCareersScraper\ncurl_cffi chrome120" as META
  component "NetflixCareersScraper\ncurl_cffi chrome120" as NETFLIX
  component "UberCareersScraper\ncurl_cffi chrome120" as UBER
  component "RubrikCareersScraper\ncurl_cffi chrome120" as RUBRIK
}

' ── Link Registry ────────────────────────────────────────────────
package "Site Registry (backend/sites/)" as SITES {
  database "links.txt\n[Active Crawled Portals]" as LINKS
  database "new_links.txt\n[Pending Review]" as NEWLINKS
}

' ── External ─────────────────────────────────────────────────────
package "Target Career Sites" as EXT {
  component "amazon.jobs" as AMZWEB
  component "careers.google.com" as GOOGWEB
  component "apply.careers.microsoft.com" as MSFTWEB
  component "metacareers.com" as METAWEB
  component "jobs.netflix.net" as NFLXWEB
  component "jobs.uber.com" as UBERWEB
  component "rubrik.com/careers" as RUBRIKWEB
}

' ── Flows ─────────────────────────────────────────────────────
USER --> DASH : "Searches & filters jobs"
USER --> ADMINUI : "Monitors crawlers & triggers scrape"
USER --> HISTUI : "Tracks application status"
USER --> PROFUI : "Uploads resume (PDF/TXT)"

DASH --> CTX : "reads preferences"
DASH --> APICLIENT : "fetchJobs(filters)"
DASH --> SCORE : "computes match %"
ADMINUI --> APICLIENT : "crawler status & trigger"
HISTUI --> APICLIENT : "get/update applications"
PROFUI --> APICLIENT : "uploadResumeFile()"

APICLIENT -down-> MAIN : "REST API Calls (JSON)"

MAIN -right-> FILTERS : "query jobs"
MAIN -down-> RESUME : "parse PDF text & skills"
MAIN -down-> CACHE : "check / invalidate cache"
MAIN -down-> SQLITEDB : "CRUD operations"
FILTERS <--> SQLITEDB : "indexed seeks & pagination"

ADMINUI ..> WORKER : "manual trigger"
WORKER -left-> LINKS : "read active URLs"
WORKER -down-> BASE : "dispatch scraping"

BASE <|-- AMAZON
BASE <|-- GOOGLE
BASE <|-- MSFT
BASE <|-- META
BASE <|-- NETFLIX
BASE <|-- UBER
BASE <|-- RUBRIK

AMAZON -down-> AMZWEB : "TLS impersonation (chrome120)"
GOOGLE -down-> GOOGWEB
MSFT -down-> MSFTWEB
META -down-> METAWEB
NETFLIX -down-> NFLXWEB
UBER -down-> UBERWEB
RUBRIK -down-> RUBRIKWEB

BASE --> SQLITEDB : "upsert_jobs() + 48h fuzzy dedup"
SQLITEDB ..> CACHE : "cache invalidation on write"

@enduml
