# ==============================================================================
# HireMe — Project .gitignore
# ==============================================================================

# Node / Next.js Dependencies & Artifacts
node_modules/
**/node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
.turbo/
**/.turbo/
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# Python Virtual Environments & Bytecode
.venv/
venv/
env/
ENV/
*.venv
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Databases & Local Storage
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# AI Assistant & Local Tooling Artifacts
.agents/
.gemini/
.claude/
